<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>patrol_bringup</name>
  <version>0.1.0</version>
  <description>
    Entry-point launch package for the patrol system.
    Orchestrates Gazebo simulation, Nav2 stack, and RViz.
  </description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Simulation -->
  <exec_depend>turtlebot3_gazebo</exec_depend>

  <!-- Navigation -->
  <exec_depend>navigation2</exec_depend>

  <!-- Visualisation -->
  <exec_depend>rviz2</exec_depend>

  <!-- Runtime launch helpers -->
  <exec_depend>ros2launch</exec_depend>

  <!-- Sibling packages -->
  <exec_depend>patrol_simulation</exec_depend>
  <exec_depend>patrol_navigation</exec_depend>
  <exec_depend>patrol_waypoint</exec_depend>
  <exec_depend>patrol_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
